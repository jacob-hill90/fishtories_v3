# Local development only. Never commit your real backend/.env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-strong-secret-only-if-you-need-it-locally
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Leave DATABASE_URL unset locally to use database/dev.sqlite3.

# PRODUCTION: enter these in Render > Environment, not this file.
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<50+ random characters>
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# DATABASE_URL=postgresql://... (Neon pooled URL with TLS)
# R2_BUCKET_NAME=fishtories-private-media
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=... (R2 scoped key)
# R2_SECRET_ACCESS_KEY=... (R2 scoped secret)
